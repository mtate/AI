\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls1\ilvl0
\f1\b \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	1	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 A reliable financial RAG pipeline
\f0\b0  \'97 ingestion 
\f2 \uc0\u8594 
\f0  normalization 
\f2 \uc0\u8594 
\f0  chunking 
\f2 \uc0\u8594 
\f0  embedding 
\f2 \uc0\u8594 
\f0  Chroma 
\f2 \uc0\u8594 
\f0  retrieval 
\f2 \uc0\u8594 
\f0  answer generation.\
\ls1\ilvl0
\f1\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	2	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 An experimental/evaluation pipeline
\f0\b0  \'97 benchmark questions 
\f2 \uc0\u8594 
\f0  DeepEval 
\f2 \uc0\u8594 
\f0  configuration experiments 
\f2 \uc0\u8594 
\f0  GEPA prompt optimization 
